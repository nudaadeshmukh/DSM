# =========================
# APP CONFIGURATION
# =========================
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your_secret_key_here

# =========================
# DATABASE CONFIG
# =========================

# Choose: mysql or sqlite
DB_BACKEND=mysql

# --- MySQL Settings ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=supply_chain_db

# --- SQLite Settings (used if DB_BACKEND=sqlite) ---
SQLITE_DB_PATH=dsm_project.db

# =========================
# DATABASE INITIALIZATION
# =========================

# Set to true only for first run (creates tables automatically)
INIT_DB_ON_STARTUP=true